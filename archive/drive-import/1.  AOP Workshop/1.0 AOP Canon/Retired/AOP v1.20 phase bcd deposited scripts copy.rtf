import numpy as np\
# (i) Lane-Emden n=3: theta'' + (2/xi) theta' + theta^3 = 0, theta(0)=1, theta'(0)=0\
def lane_emden(n=3, h=1e-4, xmax=8):\
    xi=h; th=1-h*h/6; dth=-h/3  # series start\
    while th>0 and xi<xmax:\
        d2=-(2/xi)*dth-max(th,0)**n\
        th+=dth*h; dth+=d2*h; xi+=h\
    return xi\
